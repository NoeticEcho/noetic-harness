{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision_question.schema.json",
  "title": "Decision question",
  "description": "One typed question a System One provider may be asked about this repository's work. Its content is fingerprinted per version; editing it without `harness questions --bump` is a validate error, because every recorded answer would then claim to answer text it never saw.",
  "type": "object",
  "required": [
    "id",
    "version",
    "type",
    "instructions",
    "options",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "version": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "noul",
        "choice",
        "score"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array"
    },
    "criteria": {
      "type": [
        "object",
        "null"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibration_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": "string"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "fingerprint",
          "at",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "at": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
