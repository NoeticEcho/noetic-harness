{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trust_levels.schema.json",
  "title": "Trust levels",
  "type": "object",
  "required": [
    "version",
    "levels",
    "escalation"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "doc": {
      "type": "string"
    },
    "plane": {
      "type": "string",
      "enum": [
        "development",
        "runtime"
      ],
      "description": "Which plane these trust levels' text is written for; absent means `development`. A runtime role is composed from runtime trust levels only: `.agents/runtime/trust_levels.json`, or this file when it says `runtime`."
    },
    "levels": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "summary",
          "may"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "T5"
            ]
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "inherits": {
            "type": "string"
          },
          "may": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "may_not": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_gate": {
            "type": "string"
          },
          "default_holder": {
            "type": "string"
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "never_self_granted",
        "never_delegated_sideways"
      ],
      "properties": {
        "doc": {
          "type": "string"
        },
        "never_self_granted": {
          "type": "boolean",
          "const": true
        },
        "never_delegated_sideways": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
