{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tools.schema.json",
  "title": "Tool permissions",
  "type": "object",
  "required": [
    "version",
    "tools",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "doc": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "min_trust",
          "present"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "plane": {
            "type": "string",
            "enum": [
              "development",
              "runtime"
            ],
            "description": "Which plane this tool belongs to; absent means `development`. A runtime role may hold only runtime tools."
          },
          "kind": {
            "type": "string",
            "enum": [
              "builtin",
              "cli",
              "service",
              "mcp",
              "function",
              "data"
            ],
            "description": "builtin, cli, service and mcp run or reach something on a machine, and belong to the development plane. function (a product function, called by name) and data (a read of the product's own data) run nothing on a machine, and are the only kinds a runtime tool may have."
          },
          "min_trust": {
            "type": "string",
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "T5"
            ]
          },
          "probe": {
            "type": "string",
            "description": "A shell command whose zero exit status means the tool is present."
          },
          "present": {
            "type": "boolean",
            "description": "The recorded expectation. `harness inspect --tools` runs the probe and reports where reality disagrees."
          },
          "install": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
