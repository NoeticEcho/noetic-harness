{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "role_rules.schema.json",
  "title": "Role derivation rules",
  "type": "object",
  "required": [
    "version",
    "rules",
    "nucleus"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "doc": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "match"
        ],
        "additionalProperties": false,
        "properties": {
          "match": {
            "type": "string",
            "description": "Case-insensitive regular expression over the role name."
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tools granted to the roles this rule matches, beyond what their capabilities carry. For a grant one role's work needs and its capabilities' other holders do not. A tool grant is authority, so a rule carrying tools must say why."
          },
          "why": {
            "type": "string",
            "description": "Why this rule exists. Required by the builder when the rule grants tools."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "archetype": {
            "type": "string",
            "enum": [
              "owner",
              "steward",
              "coordinator",
              "adversary",
              "investigator"
            ]
          },
          "trust": {
            "type": "string",
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "T5"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "dormant"
            ]
          },
          "note": {
            "type": "string",
            "description": "Why this rule is shaped the way it is. Read by humans; ignored by the generator."
          }
        }
      }
    },
    "nucleus": {
      "type": "object",
      "required": [
        "ids"
      ],
      "properties": {
        "doc": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
