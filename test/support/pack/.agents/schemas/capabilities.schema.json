{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capabilities.schema.json",
  "title": "Capability vocabulary",
  "description": "What routing actually matches on. A capability binds a kind of work to the skills, tools, gates, evidence and context it requires.",
  "type": "object",
  "required": ["version", "capabilities"],
  "properties": {
    "version": { "type": "integer" },
    "doc": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "doc", "skills", "tools", "gates", "evidence", "context"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$" },
          "doc": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "gates": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "context": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
