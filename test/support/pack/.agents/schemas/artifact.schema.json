{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact.schema.json",
  "title": "Artifact envelope",
  "description": "Every durable thing the harness produces. provenance.unverified is required and an empty list is a claim that everything was checked.",
  "type": "object",
  "required": ["id", "kind", "version", "created_by", "created_at", "status", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": {
      "type": "string",
      "enum": ["Requirement", "RFC", "ADR", "ArchitectureMap", "TaskGraph", "CodePatch", "SchemaChange", "Migration", "AgentSpec", "SkillSpec", "WorkflowSpec", "WorldSpec", "TrajectorySpec", "SceneRecipe", "AssetManifest", "DatasetManifest", "Experiment", "EvaluationRun", "RenderEvidence", "VisualCritique", "ReleaseCandidate", "IncidentReport", "Postmortem", "ResearchNote", "Hypothesis", "Benchmark", "HoldoutResult", "TransferTest", "ProvenanceRecord", "CalibrationReport"]
    },
    "version": { "type": "integer" },
    "parent_ids": { "type": "array", "items": { "type": "string" } },
    "created_by": { "type": "string" },
    "created_at": { "type": "string" },
    "workflow": { "type": "string" },
    "step": { "type": "string" },
    "task": { "type": "string" },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "status": { "type": "string", "enum": ["draft", "proposed", "accepted", "superseded", "rejected"] },
    "evidence": {
      "type": "array",
      "description": "Commands and their results. A claim without one is not evidence.",
      "items": {
        "type": "object",
        "required": ["what", "result"],
        "properties": {
          "what": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string" },
          "outcome": { "type": "string", "enum": ["passed", "failed", "skipped", "unavailable"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "unverified"],
      "properties": {
        "source": { "type": "string", "enum": ["run", "human", "ci", "external"] },
        "commit": { "type": "string" },
        "tool_versions": { "type": "object" },
        "unverified": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evaluation": { "type": "object" }
  }
}
