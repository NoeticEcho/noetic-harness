{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry.schema.json",
  "title": "Agent registry",
  "description": "GENERATED by .agents/tools/build_registry.py. The competency library, not a list of running processes.",
  "type": "object",
  "required": ["version", "agents", "provenance"],
  "properties": {
    "version": { "type": "integer" },
    "generated_by": { "type": "string" },
    "doc": { "type": "string" },
    "counts": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object", "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
        "note": { "type": "string" }
      }
    },
    "agents": { "type": "array", "minItems": 1, "items": { "$ref": "agent_spec.schema.json" } }
  }
}
